{
  "formatVersion": 1,
  "provider": "cognito",
  "name": "myapp",
  "userPoolId": "us-east-1_AbCdEfGhI",
  "usernameConfiguration": {
    "caseSensitive": false
  },
  "signIn": {
    "email": true,
