{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest/globals"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@cognito-kit/core": ["packages/core/src/index.ts"],
      "@cognito-kit/runtime": ["packages/runtime/src/index.ts"],
      "@cognito-kit/local-auth": ["packages/local-auth/src/index.ts"],
      "@cognito-kit/testing": ["packages/testing/src/index.ts"],
      "@cognito-kit/infrastructure": ["packages/infrastructure/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/tsup.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "examples/nextjs/.next"]
}
