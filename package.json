{
  "name": "cognito-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Cognito without learning Cognito. Local-first developer toolkit for Amazon Cognito.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:contract && pnpm test:infra && pnpm test:integration",
    "test": "vitest run --project unit --project contract --project infra --project integration",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:infra": "vitest run --project infra",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && node tests/e2e/run.mjs",
    "test:aws": "node tests/aws/run.mjs",
    "test:aws:local": "node tests/aws/run.mjs --local",
    "docs:generate": "pnpm build && typedoc && node scripts/generate-docs.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "dev": "node tests/e2e/demo.mjs"
  },
  "dependencies": {
    "cognito-kit": "workspace:*"
  },
  "devDependencies": {
    "@cognito-kit/aws": "workspace:*",
    "@cognito-kit/core": "workspace:*",
    "@cognito-kit/infrastructure": "workspace:*",
    "@cognito-kit/local-auth": "workspace:*",
    "@cognito-kit/runtime": "workspace:*",
    "@cognito-kit/testing": "workspace:*",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.4.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jose": "^5.9.6",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
